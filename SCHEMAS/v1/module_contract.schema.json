{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andrebarros78/pod/SCHEMAS/v1/module_contract.schema.json",
  "title": "POD Module Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "objective",
    "responsibility",
    "inputs",
    "outputs",
    "dependencies",
    "consumers",
    "interfaces",
    "state",
    "persistence",
    "error_contract",
    "security_boundary",
    "recovery_behavior",
    "acceptance_criteria",
    "out_of_scope"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "responsibility": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "persistence": {
      "type": "string",
      "minLength": 1
    },
    "error_contract": {
      "type": "string",
      "minLength": 1
    },
    "security_boundary": {
      "type": "string",
      "minLength": 1
    },
    "recovery_behavior": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

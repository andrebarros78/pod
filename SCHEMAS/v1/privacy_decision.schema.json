{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andrebarros78/pod/SCHEMAS/v1/privacy_decision.schema.json",
  "title": "POD PrivacyDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "project_id", "operation_id", "data_ids", "operation", "policy_version", "decision", "reason_codes", "minimization_applied", "transformation_refs", "decided_at", "engine_version"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "data_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "operation": {"type": "string", "minLength": 1},
    "purpose_id": {"type": ["string", "null"]},
    "policy_version": {"type": "string", "minLength": 1},
    "destination_ref": {"type": ["string", "null"]},
    "processor_ref": {"type": ["string", "null"]},
    "decision": {"enum": ["allow", "deny", "require_human_legal_input"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "minimization_applied": {"type": "boolean"},
    "transformation_refs": {"type": "array", "items": {"type": "string"}},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "decided_at": {"type": "string", "format": "date-time"},
    "engine_version": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "allow"}}, "required": ["decision"]}, "then": {"properties": {"purpose_id": {"type": "string", "minLength": 1}, "reason_codes": {"contains": {"const": "POLICY_ALLOW"}}}}}
  ]
}
